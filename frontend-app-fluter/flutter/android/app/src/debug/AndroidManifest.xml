<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Allow plain HTTP (cleartext) during development only. Android 9+
         blocks cleartext by default, which silently prevents requests to a
         local backend served over http:// (e.g. http://10.0.2.2:8000).
         This override lives in the debug manifest, so release builds stay
         HTTPS-only. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
