{
  "name": "Flutter Development",

  "dockerComposeFile": "../docker-compose.yml",

  "service": "flutter",

  "workspaceFolder": "/flutter",

  "shutdownAction": "stopCompose",

  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "fnando.linter",
        "alexisvt.flutter-snippets",
        "openai.chatgpt",
        "google.google-antigravity"
      ]
    }
  }
}